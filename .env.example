# Your Recall.ai API key (get one at https://recall.ai)
RECALL_API_KEY=your-api-key-here

# Your Recall.ai region: us-east-1, us-west-2, eu-central-1, or ap-northeast-1
RECALL_REGION=us-east-1

# Port for the local server (serves the recording viewer + token API)
# Default is 3131 (port 3000 is used by Electron Forge's dev server)
PORT=3131